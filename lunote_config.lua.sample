-- lunote_config.lua is entirely optional. The API key is normally read from a
-- .env file (see .env.sample); everything set here overrides both .env and the
-- built-in defaults.

local CONFIGURATION = {
    -- Overrides OPENROUTER_API_KEY from .env.
    -- api_key = "YOUR_API_KEY",

    -- Overrides OPENROUTER_MODEL from .env.
    -- model = "google/gemini-2.5-flash-lite",

    -- Any endpoint speaking the OpenAI chat-completions dialect, e.g. Ollama.
    -- base_url = "https://openrouter.ai/api/v1/chat/completions",

    additional_parameters = {},

    features = {
        -- Optional. Replaces the built-in instructions used by the "Explain"
        -- button, if you want the explanations tailored differently.
        -- explain_prompt = "Explain this passage to a ten year old.",

        -- Optional. Adds an "AI Translate" button to the highlight menu.
        -- translate_to = "French",

        -- Explanations are saved onto the book's highlight as a note, so they
        -- show up in Bookmarks and export with your own notes. Set to false to
        -- keep them in the plugin's history only and leave your notes alone.
        -- save_to_notes = false,

        -- Translations stay out of the history unless you ask for them.
        -- log_translations = true,

        -- One note per book in an Obsidian vault: every highlight from that book
        -- with your note on it and its explanations. Normally set from
        -- Menu -> Lunote -> Obsidian vault; what you set there wins over these.
        --
        -- Where Obsidian is running, with its Local REST API plugin enabled, and
        -- that plugin's API key. "Sync" pushes the notes to it.
        -- obsidian_url = "192.168.1.20:27124",
        -- obsidian_api_key = "your-local-rest-api-key",

        -- Or a vault folder on the device itself, which needs no network.
        -- obsidian_vault = "/mnt/us/Obsidian/Reading",

        -- The folder inside the vault the notes go in. Defaults to Lunote.
        -- obsidian_folder = "Lunote",

        -- A book's note is written to that folder when you close the book. Set
        -- to false to only write when you ask for it.
        -- obsidian_auto_export = false,
    },
}

return CONFIGURATION
