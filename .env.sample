# Copy this file to `.env` in the askgpt.koplugin directory and fill in your key.
# Get one at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any model id from https://openrouter.ai/models works.
# Defaults to google/gemini-2.5-flash-lite.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# To use OpenAI directly instead, leave OPENROUTER_API_KEY unset and use:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
