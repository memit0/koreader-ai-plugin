# Copy this file to `.env` in the lunote.koplugin directory and fill in your key.
# Get one at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any model id from https://openrouter.ai/models works.
# Defaults to google/gemini-2.5-flash-lite.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional. Where "Sync to web app" pushes your highlights, notes and
# explanations. Only needed if you self-host the web app.
# LUNOTE_SYNC_URL=https://your-instance.example.com

# Optional. Where Obsidian is running, with its Local REST API plugin enabled,
# and that plugin's API key. "Sync" then pushes one note per book to it.
# Normally set from Menu -> Lunote -> Obsidian vault instead; what you set there
# wins over these.
# LUNOTE_OBSIDIAN_URL=192.168.1.20:27124
# LUNOTE_OBSIDIAN_KEY=your-local-rest-api-key

# Optional. A vault folder on the device itself, for when the vault (or a folder
# something else syncs) lives on the e-reader. Needs no network.
# LUNOTE_OBSIDIAN_VAULT=/mnt/us/Obsidian/Reading

# Optional. The folder inside the vault the notes go in. Defaults to Lunote.
# LUNOTE_OBSIDIAN_FOLDER=Lunote
