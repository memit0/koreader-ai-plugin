# Copy this file to `.env` in the lunote.koplugin directory and fill in your key.
# Get one at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any model id from https://openrouter.ai/models works.
# Defaults to google/gemini-2.5-flash-lite.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional. Where "Sync to web app" pushes your highlights, notes and
# explanations. Only needed if you self-host the web app.
# LUNOTE_SYNC_URL=https://your-instance.example.com
